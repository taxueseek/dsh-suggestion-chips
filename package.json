{
  "name": "dsh-suggestion-chips",
  "version": "0.3.4",
  "description": "Clickable suggestion chips and Tab ghost prediction: Level 0 deterministic extraction, dual-mode synergy (both/chips/tab), high-risk safety gate, and adoption indicator.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "assets/icon.svg",
    "assets/turn.zh.png",
    "assets/turn.en.png",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "suggestion-chips",
    "suggestions",
    "chips",
    "ui"
  ],
  "license": "MIT",
  "author": "taxueseek",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": "^0.2.0-rc.2 || ^0.2.1-0 || ^0.2.2-0"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2 || ^0.2.1-0 || ^0.2.2-0",
    "@deepseek-ai/schemastery": "^3.19.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taxueseek/dsh-suggestion-chips.git"
  },
  "homepage": "https://github.com/taxueseek/dsh-suggestion-chips#readme",
  "bugs": {
    "url": "https://github.com/taxueseek/dsh-suggestion-chips/issues"
  },
  "scripts": {
    "test": "node --test"
  },
  "icon": "assets/icon.svg",
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2 || ^0.2.1-0 || ^0.2.2-0",
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
